// Configuración de Cloudflare Workers para el SITIO DE PRUEBAS.
// Es distinto en el sitio real (cambia "name"), igual que config.js: no copiarlo al pasar a producción.
// Cloudflare corre "bash cloudflare-publicar.sh" y pone en línea la carpeta "publicado".
{
  "name": "elysium-uat",
  "compatibility_date": "2026-10-01",
  // worker.js reenvía /__/auth/ (Entrar con Google) a Firebase; todo lo demás es el sitio tal cual
  "main": "worker.js",
  "vars": { "FIREBASE_AUTH_HOST": "vtes-uat.firebaseapp.com" },
  "assets": {
    "directory": "./publicado",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/__/auth/*"]
  }
}
